# Copy this file to .env.local and fill it in. .env.local is git-ignored.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon / publishable key (Project Settings -> API Keys). It is safe in a web app because
# row-level security protects the data. NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=
